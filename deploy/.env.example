# Copy to .env next to docker-compose.yml (cloud-init writes /opt/ads-mcp/.env
# and points ADS_MCP_ENV_FILE at it). Never commit the real file.

# --- Google OAuth client (Google Cloud Console -> Clients, type Web application)
# Authorized redirect URI must be: https://<ADS_MCP_HOSTNAME>/auth/callback
GOOGLE_ADS_MCP_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_ADS_MCP_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxx

# --- Public URL of this server (no trailing slash)
GOOGLE_ADS_MCP_BASE_URL=https://ads-mcp.mlabs.ae

# --- Random 32+ byte secret. Signs the tokens the server issues to MCP clients
# and derives the encryption key for the stored Google tokens.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
GOOGLE_ADS_MCP_JWT_SIGNING_KEY=change-me

# --- Google Cloud project that holds the OAuth client and the Ads API access level
GOOGLE_PROJECT_ID=marvento-labs-ads

# --- Optional. Developer tokens were sunset on 2026-09-09; access now follows the
# Cloud project. Leave empty unless Google support asks for it.
GOOGLE_ADS_DEVELOPER_TOKEN=

# --- Optional. Manager (MCC) customer id if the accounts are reached through one.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Safety rail: highest daily budget (account currency units) any tool may
# create or set. Raise deliberately when a campaign needs more.
ADS_MCP_MAX_DAILY_BUDGET=500

# --- Used by Caddy
ADS_MCP_HOSTNAME=ads-mcp.mlabs.ae
ADS_MCP_ACME_EMAIL=admin@mlabs.ae
