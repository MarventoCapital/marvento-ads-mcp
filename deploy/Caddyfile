{
	email {$ADS_MCP_ACME_EMAIL}
}

{$ADS_MCP_HOSTNAME} {
	# No `encode` here: compression can buffer the streamed (SSE) responses
	# MCP uses, and the JSON payloads are small. Caddy's reverse_proxy flushes
	# text/event-stream immediately, so no flush_interval is needed.
	reverse_proxy mcp:8080 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	log {
		output stdout
		format console
	}
}
