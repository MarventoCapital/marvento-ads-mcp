{
	email {$ADS_MCP_ACME_EMAIL}
}

{$ADS_MCP_HOSTNAME} {
	encode zstd gzip

	# Streamable HTTP MCP uses long-lived SSE responses; Caddy flushes
	# text/event-stream automatically, so no flush_interval is needed.
	reverse_proxy mcp:8080 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	log {
		output stdout
		format console
	}
}
